[Unit]
Description=Volatile RAM Overlays for /usr and /opt
DefaultDependencies=no
Conflicts=umount.target
# CRITICAL: Must start AFTER format-persistent, systemd-sysext, and systemd-confext
After=format-persistent.service systemd-sysext.service systemd-confext.service local-fs.target
Requires=format-persistent.service
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/volatile-overlays.sh start
ExecStop=/usr/sbin/volatile-overlays.sh stop

[Install]
WantedBy=sysinit.target