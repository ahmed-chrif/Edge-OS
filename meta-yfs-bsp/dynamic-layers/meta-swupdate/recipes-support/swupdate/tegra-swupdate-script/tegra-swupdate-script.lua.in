local function get_current_alt_slot()
    local handle = io.popen("nvbootctrl get-current-slot")
    if not handle then
        print("Failed to get-current-slot")
        return nil, nil
    end
    local result = handle:read("*a")
    handle:close()
    local current_slot = result:match("%d")
    if not current_slot then
        return nil, nil
    end
    local alt_slot = current_slot == "1" and "0" or "1"
    return current_slot, alt_slot
end

local function set_active_slot(slot)
    local command = "nvbootctrl set-active-boot-slot " .. slot
    return os.execute(command)
end

local function file_exists(path)
    local file = io.open(path, "r")
    if file then
        file:close()
        return true
    end
    return false
end

local function write_file(path, content)
    local file, err = io.open(path, "w")
    if not file then
        print("Failed to open file for writing: " .. path .. " (" .. tostring(err) .. ")")
        return false
    end
    file:write(content)
    file:close()
    return true
end

local function reset_unbootable_status(slot)
    local slot_str = (tostring(slot) == "1") and "SlotB" or "SlotA"
    local value = "\\x00\\x00\\x00\\x00"
    local guid = "781e084c-a330-417c-b678-38e696380cb9"
    local varname = "RootfsStatus" .. slot_str
    local cmd = string.format(
        '/bin/sh -c ". /usr/bin/uefi_common.func; set_efi_var \'%s\' \'%s\' \'%s\'"',
        varname, guid, value)
    local result, detail = os.execute(cmd)
    if result ~= true then
        print("WARNING: Unable to reset unbootable status for slot " .. slot_str ..
              " : " .. tostring(detail))
    end
end

local function clear_os_indications()
    local cmd = '/bin/sh -c ". /usr/bin/uefi_common.func; set_efi_var \'OsIndications\' \'8be4df61-93ca-11d2-aa0d-00e098032b8c\' \'\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\'"'
    local result, detail = os.execute(cmd)
    if result ~= true then
        print("WARNING: Unable to clear OsIndications: " .. tostring(detail))
    end
end

local function clear_slot_markers(slot)
    if "@TEGRA_SWUPDATE_LAST_CAPSULE_UPDATE_COMPLETE_SLOT_MARKER@" == "" then
        return
    end
    local base = "@TEGRA_SWUPDATE_LAST_CAPSULE_UPDATE_COMPLETE_SLOT_MARKER@"
    os.remove(base .. slot)
    os.remove(base .. slot .. "-inprogress")
    os.remove(base .. slot .. "-rootfs-inprogress")
    os.remove(base .. slot .. "-pending")
end

local function capsule_update_succeeded()
    local handle = io.popen("nvbootctrl dump-slots-info 2>/dev/null")
    if not handle then
        return false
    end
    local output = handle:read("*a") or ""
    handle:close()
    local status = output:match("Capsule update status:%s*(%d)")
    return status == "1"
end

local function get_rootfs_device(slot)
    if tostring(slot) == "1" then
        return "/dev/disk/by-partlabel/APP_b"
    else
        return "/dev/disk/by-partlabel/APP"
    end
end

local function rootfs_slot_is_valid(slot)
    local dev = get_rootfs_device(slot)
    if not file_exists(dev) then
        print("WARNING: rootfs device not found: " .. dev)
    end

    local handle = io.popen("blkid -o value -s TYPE " .. dev .. " 2>/dev/null")
    local fstype = ""
    if handle then
        fstype = (handle:read("*a") or ""):gsub("%s+", "")
        handle:close()
    end
    if fstype ~= "squashfs" then
        print("ERROR: slot " .. slot .. " fstype is '" .. tostring(fstype) .. "', expected squashfs")
        return false
    end

    local mnt = "/tmp/swupdate-rootfs-check"
    os.execute("mkdir -p " .. mnt)
    local mount_cmd = "mount -t squashfs -o ro " .. dev .. " " .. mnt .. " 2>/dev/null"
    local ok = os.execute(mount_cmd)
    if ok ~= true then
        print("ERROR: failed to mount slot " .. slot .. " rootfs from " .. dev)
        os.execute("umount " .. mnt .. " 2>/dev/null")
        return false
    end

    local has_sbin = file_exists(mnt .. "/sbin") or file_exists(mnt .. "/usr/sbin")
    local has_etc  = file_exists(mnt .. "/etc")
    os.execute("umount " .. mnt .. " 2>/dev/null")

    if not (has_sbin and has_etc) then
        print("ERROR: slot " .. slot .. " mounted but does not look like a valid rootfs")
        return false
    end

    print("Slot " .. slot .. " rootfs looks valid (" .. dev .. ")")
    return true
end

function postinst()
    local success = false
    local result = ""
    local current_slot, alt_slot = get_current_alt_slot()
    if not current_slot or not alt_slot then
        result = "Couldn't determine current or alt slot"
        return success, result
    end

    local marker_base = "@TEGRA_SWUPDATE_LAST_CAPSULE_UPDATE_COMPLETE_SLOT_MARKER@"
    local inprogress_slot_marker = marker_base .. alt_slot .. "-inprogress"
    local complete_slot_marker   = marker_base .. alt_slot
    local rootfs_inprogress_marker = marker_base .. alt_slot .. "-rootfs-inprogress"
    
    -- NEW: The pending marker ensures the next boot knows it is on probation
    local pending_slot_marker = marker_base .. alt_slot .. "-pending"

    local has_stale_or_failed_marker = false

    if marker_base ~= "" and file_exists(inprogress_slot_marker) then
        print("Found in-progress marker for slot " .. alt_slot)
        if capsule_update_succeeded() then
            print("Capsule update status is success – clearing stale in-progress marker")
            clear_slot_markers(alt_slot)
        else
            print("WARNING: Incomplete or failed previous capsule update for slot " .. alt_slot)
            has_stale_or_failed_marker = true
            clear_os_indications()
        end
    end

    -- Case A: Bootloader Capsule File is Present
    if file_exists("@TEGRA_SWUPDATE_CAPSULE_INSTALL_PATH@") then
        if has_stale_or_failed_marker then
            print("ERROR: Refusing to stage new capsule while previous one is incomplete")
            clear_slot_markers(alt_slot)
            success = false
            result = "Aborted: previous capsule update for slot " .. alt_slot .. " was incomplete"
            return success, result
        end

        print("Running bootloader update script")
        success, detail = os.execute("/usr/bin/oe4t-set-uefi-OSIndications")
        result = "oe4t-set-uefi-OSIndications complete with "

        if success then
            result = result .. "success"
            print("Resetting unbootable status for slot " .. alt_slot)
            reset_unbootable_status(alt_slot)

            if marker_base ~= "" then
                os.remove(complete_slot_marker)
                -- For capsules, the bootloader handles the flash on reboot, so it is "inprogress"
                local ok = write_file(inprogress_slot_marker, current_slot)
                if ok then
                    print("Wrote capsule update inprogress marker for slot " .. alt_slot)
                else
                    print("Failed to write inprogress marker for slot " .. alt_slot)
                end
            end
        else
            result = result .. "failure: " .. tostring(detail)
        end

    -- Case B: RootFS Only Update (No Bootloader Capsule)
    else
        if has_stale_or_failed_marker then
            print("WARNING: Previous capsule update was incomplete, but allowing rootfs-only path")
            clear_slot_markers(alt_slot)
        end

        if @TEGRA_SWUPDATE_BOOTLOADER_INSTALL_ONLY_IF_DIFFERENT@ then
            print("RootFS-only update: validating inactive slot " .. alt_slot .. " before switch")

            -- STEP: VALIDATE
            if not rootfs_slot_is_valid(alt_slot) then
                print("ERROR: Inactive slot " .. alt_slot .. " rootfs is invalid/incomplete – refusing slot switch")
                if marker_base ~= "" then
                    write_file(rootfs_inprogress_marker, current_slot)
                end
                success = false
                result = "Aborted: inactive slot " .. alt_slot .. " rootfs is not valid"
                return success, result
            end

            if marker_base ~= "" and file_exists(rootfs_inprogress_marker) then
                print("WARNING: Found previous rootfs-inprogress marker for slot " .. alt_slot ..
                      " – rootfs validated OK, continuing with switch")
            end

            if marker_base ~= "" then
                write_file(rootfs_inprogress_marker, current_slot)
            end

            print("Running OS switch to slot " .. alt_slot)
            success, detail = set_active_slot(alt_slot)

            -- STEP: PENDING
            if success then
                result = "switch_slots to " .. alt_slot .. " completed. Status set to PENDING."
                if marker_base ~= "" then
                    -- Remove the write-in-progress marker, because the flash is done
                    os.remove(rootfs_inprogress_marker)
                    -- We are no longer "complete" on this slot (from an old update), we are pending
                    os.remove(complete_slot_marker)
                    
                    -- Create the PENDING marker. 
                    -- A post-boot service will look for this file, run health checks, 
                    -- and if they pass, it will delete this and create the complete_slot_marker.
                    write_file(pending_slot_marker, alt_slot)
                    print("Update staged successfully. Slot " .. alt_slot .. " is now PENDING reboot and confirmation.")
                end
            else
                result = "switch_slots to " .. alt_slot .. " completed with failure: " .. tostring(detail)
                -- leave rootfs-inprogress marker so next run knows switch did not finish cleanly
            end
        else
            result = "Missing @TEGRA_SWUPDATE_CAPSULE_INSTALL_PATH@, cannot complete update"
        end
    end

    return success, result
end